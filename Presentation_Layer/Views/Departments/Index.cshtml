
@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";

}
<div>
    <a class="btn btn-primary mt-3" asp-action="Create">Create New Department</a>
</div>
@if (Model.Any())
{
    <h1>All Departemnts</h1>
    <table class="table table-striped table-hover ">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(d => d.Code)</td>
                <td>@Html.DisplayNameFor(d => d.Name)</td>
                <td>@Html.DisplayNameFor(d => d.DateTime)</td>

                <td>Details</td>
                <td>Edit</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.DateTime</td>


                    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info"><i class="fas fa-eye"></i>Details</a></td>
                    <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success"><i class="fas fa-edit"></i>Edit</a></td>
                    <td><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="fas fa-trash"></i>Delete</a></td>
                   
                </tr>

            }

        </tbody>




    </table>
}
else
{
    <div class="mt-3 alert-warining">
        <h2 class="bg-warnings">No Department</h2>
    </div>
}




