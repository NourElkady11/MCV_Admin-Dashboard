
@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Index";

}
<div>
@*     <h1>@ViewData["message"]</h1>*@ 

<h1 class="alert-success">@TempData["Message"]</h1>
<h1 class="alert-success">@TempData["Message2"]</h1>

<a class="btn btn-primary mt-3" asp-action="Create">Add New Employee</a>
</div>
@if (Model.Any())
{
    <h1>All Employees</h1>
    <table class="table table-striped table-hover ">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(d => d.Name)</td>
                <td>@Html.DisplayNameFor(d => d.Age)</td>
                <td>@Html.DisplayNameFor(d => d.Salary)</td>
                <td>@Html.DisplayNameFor(d => d.Email)</td>
                <td>@Html.DisplayNameFor(d => d.phone)</td>
                <td>@Html.DisplayNameFor(d => d.IsActive)</td>
         

                <td>Details</td>
                <td>Edit</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                 
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@Html.DisplayFor(e=>item.Salary)</td>
                    <td>@Html.DisplayFor(e=>item.Email)</td>
                    <td>@Html.DisplayFor(e=>item.phone)</td>
                    <td>
                    @if(@item.IsActive){
                        <i class="fa-solid fa-circle" style="color:green"></i>
                    }else{
                    <i class="fa-solid fa-circle" style="color:red"></i>

                    }
                    </td>
                  
                    <partial name="Buttons_partial" model="item.Id"></partial>


                   
                </tr>

            }

        </tbody>




    </table>
}
else
{
    <div class="mt-3 alert-warining">
        <h2 class="bg-warning">No Employees yet</h2>
    </div>
}




